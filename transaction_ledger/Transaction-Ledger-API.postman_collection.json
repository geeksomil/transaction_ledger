              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('type is credit', () => pm.expect(pm.response.json().data.type).to.eql('credit'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"account_id\": \"{{accountA}}\",\n  \"type\": \"credit\",\n  \"amount\": 100,\n  \"description\": \"Deposit\",\n  \"reference_id\": \"REF001\"\n}",
