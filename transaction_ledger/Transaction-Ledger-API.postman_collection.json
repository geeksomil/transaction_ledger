{
  "info": {
    "_postman_id": "a1f3c2e0-4d5b-4a6f-9c7e-transaction-ledger",
    "name": "Transaction Ledger API",
    "description": "Full route + edge-case coverage for the Transaction Ledger API (NestJS + TypeORM + SQLite). Mirrors API_DOCUMENTATION.md. Run folders top-to-bottom: '0. Setup' must run first to populate {{accountA}} / {{accountB}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api", "type": "string" },
    { "key": "accountA", "value": "", "type": "string" },
    { "key": "accountB", "value": "", "type": "string" },
    { "key": "accountScenario", "value": "", "type": "string" },
    { "key": "unknownUuid", "value": "11111111-1111-4111-8111-111111111111", "type": "string" }
  ],
  "item": [
    {
      "name": "0. Setup",
      "description": "Creates the two accounts used by every other folder. Run these two requests first.",
      "item": [
        {
          "name": "Create Account A (Alice)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test('balance starts at 0', () => pm.expect(json.data.balance).to.eql(0));",
                  "pm.collectionVariables.set('accountA', json.data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/accounts",
              "host": ["{{baseUrl}}"],
              "path": ["accounts"]
            }
          },
          "response": []
        },
        {
          "name": "Create Account B (Bob)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('accountB', json.data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bob\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/accounts",
              "host": ["{{baseUrl}}"],
              "path": ["accounts"]
            }
          },
          "response": []
        }
      ]
    },
